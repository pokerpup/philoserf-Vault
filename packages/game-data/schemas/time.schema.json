{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "season_days": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "seasons": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "spring",
          "summer",
          "fall",
          "winter"
        ]
      }
    },
    "awake": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "to": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "day_tick": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "vigor_refill": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "ledger_bin_payout": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "market_hours": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "to": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "weekdays": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "weekdays",
        "timezone"
      ],
      "additionalProperties": false
    },
    "quality_multipliers": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  },
  "required": [
    "season_days",
    "seasons",
    "awake",
    "day_tick",
    "vigor_refill",
    "ledger_bin_payout",
    "market_hours",
    "quality_multipliers"
  ],
  "additionalProperties": false
}
