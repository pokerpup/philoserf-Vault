{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "crops": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "seasons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "spring",
                "summer",
                "fall",
                "winter"
              ]
            }
          },
          "where": {
            "type": "string",
            "enum": [
              "outdoor",
              "greenhouse"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "shop",
              "seed-fair",
              "bazaar",
              "vault"
            ]
          },
          "seed_price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sell_price": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "days": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "regrow": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "per_harvest": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "by_product": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "target_marks_per_day": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "seasons",
          "where",
          "source",
          "seed_price",
          "sell_price",
          "days",
          "regrow",
          "per_harvest",
          "target_marks_per_day"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "crops"
  ],
  "additionalProperties": false
}
